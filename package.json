{
  "name": "3d-market",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-build-env.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check-env": "node scripts/check-env.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "check-rls": "node scripts/check-rls.mjs",
    "db:types": "npx -y supabase@2 gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > types/database.ts",
    "db:start": "npx -y supabase@2 start",
    "db:stop": "npx -y supabase@2 stop",
    "db:reset": "npx -y supabase@2 db reset",
    "db:link": "npx -y supabase@2 link --project-ref \"$SUPABASE_PROJECT_ID\"",
    "db:push": "npx -y supabase@2 db push --include-seed",
    "db:types:local": "npx -y supabase@2 gen types typescript --local --schema public > types/database.ts",
    "netlify:dev": "npx -y netlify-cli dev",
    "deploy": "npx -y netlify-cli@latest deploy --build --prod",
    "deploy:preview": "npx -y netlify-cli@latest deploy --build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "15.5.27",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "17.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.16.2",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
