# Copia in .env.local per lo sviluppo. Su Netlify: Site configuration → Environment variables.
# Verifica con: npm run check-env (non stampa mai i valori)

# ===== Supabase (Project Settings → API) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server. Non esporre mai al client. Su Netlify: scope "Functions" (non serve nel browser).
SUPABASE_SERVICE_ROLE_KEY=
# Reference ID del progetto (per npm run db:link / db:push / db:types). Non serve a runtime.
SUPABASE_PROJECT_ID=

# ===== Stripe (chiavi di TEST in sviluppo) =====
STRIPE_SECRET_KEY=sk_test_...
# Uno o più secret separati da virgola: endpoint "Account" e endpoint "Connect"
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== Sito =====
# Senza slash finale. In produzione: https://tuodominio.it
# Su Netlify può restare vuota: si usa in automatico l'URL del deploy
# (produzione → URL, deploy preview/branch → DEPLOY_PRIME_URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Email transazionali (facoltative, provider Resend) =====
# Senza RESEND_API_KEY le email non partono: vengono solo scritte nei log.
RESEND_API_KEY=
EMAIL_FROM="3D Market <ordini@tuodominio.it>"
SUPPORT_EMAIL=assistenza@tuodominio.it
